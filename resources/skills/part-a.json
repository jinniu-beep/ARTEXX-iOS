[{"id":"recon-scope-model","n":"目标范围建模","cat":"信息收集","phase":"recon","d":"把域名/IP/CIDR/ASN 归一成测试范围，标注主域与旁站关系。","cmds":["amass intel -org <ORG>","whois <domain>"],"tools":["amass","whois"],"tags":["recon","scope"]},{"id":"recon-subdomain-passive","n":"被动子域枚举","cat":"信息收集","phase":"recon","d":"用证书透明、搜索引擎与被动 DNS 收集子域，不触碰目标。","cmds":["subfinder -d <domain> -all -silent","curl -s 'https://crt.sh/?q=%25.<domain>&output=json'"],"tools":["subfinder","crt.sh"],"tags":["recon","dns"]},{"id":"recon-subdomain-brute","n":"字典爆破子域","cat":"信息收集","phase":"recon","d":"对被动结果补盲，用高命中字典做 DNS 爆破并自动过滤泛解析。","cmds":["ksubdomain enum -d <domain> -f dict.txt","dnsx -l subs.txt -wd <domain> -a -resp"],"tools":["ksubdomain","dnsx"],"tags":["recon","dns"]},{"id":"recon-http-probe","n":"批量 HTTP 探活与指纹","cat":"信息收集","phase":"recon","d":"对存活主机做协议、状态、标题、TLS 指纹识别，输出可用 URL 集。","cmds":["httpx -l subs.txt -sc -title -td -jarm -o alive.txt"],"tools":["httpx"],"tags":["recon","fingerprint"]},{"id":"recon-port-scan-fast","n":"高速端口发现","cat":"信息收集","phase":"recon","d":"先用 naabu 做全端口粗扫，再对开放端口做服务识别。","cmds":["naabu -host <ip> -p - -rate 3000","nmap -sV -Pn -p <ports> <ip>"],"tools":["naabu","nmap"],"tags":["recon","port"]},{"id":"recon-udp-services","n":"UDP 服务枚举","cat":"信息收集","phase":"recon","d":"针对 SNMP/TFTP/NTP/IPMI 等 UDP 服务做定向探测。","cmds":["nmap -sU -Pn --top-ports 50 <ip>","snmpwalk -v2c -c public <ip>"],"tools":["nmap","snmpwalk"],"tags":["recon","udp"]},{"id":"recon-nmap-nse","n":"NSE 脚本深度识别","cat":"信息收集","phase":"recon","d":"用 NSE 分类脚本获取共享、证书、漏洞横幅与服务配置。","cmds":["nmap -Pn -sV --script default,safe -p <ports> <ip>"],"tools":["nmap"],"tags":["recon","nse"]},{"id":"recon-js-endpoint","n":"JS 端点与密钥提取","cat":"信息收集","phase":"recon","d":"解析前端 bundle 提取 API 路径、内部域名、AK/SK 与调试开关。","cmds":["katana -u <url> -jc -d 3 -o urls.txt","grep -Eo '/api/[a-zA-Z0-9_/-]+' app.js | sort -u"],"tools":["katana","gau"],"tags":["recon","js"]},{"id":"recon-history-url","n":"历史 URL 聚合","cat":"信息收集","phase":"recon","d":"汇总 Wayback、CommonCrawl、OTX 的历史 URL，找已下线接口与参数。","cmds":["gau <domain> | tee gau.txt","waybackurls <domain> | sort -u"],"tools":["gau","waybackurls"],"tags":["recon","osint"]},{"id":"recon-dir-fuzz","n":"目录与备份文件爆破","cat":"信息收集","phase":"recon","d":"用高命中字典发现后台、备份、源码泄露与调试端点。","cmds":["ffuf -u https://<host>/FUZZ -w dict.txt -mc 200,301,403 -fs 0"],"tools":["ffuf","dirsearch","spray"],"tags":["recon","fuzz"]},{"id":"recon-vhost","n":"虚拟主机枚举","cat":"信息收集","phase":"recon","d":"通过 Host 头差异发现同 IP 上的其他站点与内部服务。","cmds":["ffuf -u https://<ip>/ -H 'Host: FUZZ.<domain>' -w vhosts.txt -fs <baseline>"],"tools":["ffuf"],"tags":["recon","vhost"]},{"id":"recon-osint-github","n":"代码托管泄露检索","cat":"信息收集","phase":"recon","d":"在 GitHub/Gitee 搜索组织关键字，定位硬编码凭据与内部仓库。","cmds":["trufflehog git https://github.com/<org>/<repo>","gitleaks detect -s ./repo"],"tools":["trufflehog","gitleaks"],"tags":["osint","secret"]},{"id":"recon-cloud-bucket","n":"对象存储桶发现","cat":"信息收集","phase":"recon","d":"按命名规则枚举 OSS/S3/COS 桶，检查公开读写与目录列举。","cmds":["curl -s 'https://<bucket>.oss-cn-hangzhou.aliyuncs.com/?list-type=2'","aws s3 ls s3://<bucket> --no-sign-request"],"tools":["awscli","ossutil"],"tags":["cloud","storage"]},{"id":"recon-cert-transparency","n":"证书透明日志挖掘","cat":"信息收集","phase":"recon","d":"从 CT 日志拉取证书 SAN，发现未公开的子域与内部命名。","cmds":["curl -s 'https://crt.sh/?q=%25.<domain>&output=json' | jq -r '.[].name_value' | sort -u"],"tools":["curl","jq"],"tags":["recon","tls"]},{"id":"recon-dns-zone","n":"DNS 区域传送与记录审计","cat":"信息收集","phase":"recon","d":"尝试 AXFR 并枚举 MX/TXT/NS，找内部主机与第三方托管。","cmds":["dig AXFR <domain> @<ns>","dig +short TXT <domain>"],"tools":["dig","dnsx"],"tags":["dns"]},{"id":"recon-waf-detect","n":"WAF 与 CDN 识别","cat":"信息收集","phase":"recon","d":"识别前置 WAF/CDN 厂商，为后续 payload 变形与真实 IP 定位做准备。","cmds":["wafw00f https://<host>","nmap -Pn --script http-waf-detect <ip>"],"tools":["wafw00f"],"tags":["waf"]},{"id":"recon-real-ip","n":"源站 IP 定位","cat":"信息收集","phase":"recon","d":"通过历史解析、证书、邮件头与子域直连绕过 CDN 找源站。","cmds":["curl -s 'https://api.hackertarget.com/hostsearch/?q=<domain>'","dig +short mail.<domain>"],"tools":["dig","curl"],"tags":["cdn","bypass"]},{"id":"recon-email-harvest","n":"邮箱与人员画像","cat":"信息收集","phase":"recon","d":"收集邮箱格式与关键岗位，为口令喷洒与社工提供输入。","cmds":["theHarvester -d <domain> -b bing,linkedin -l 200"],"tools":["theHarvester"],"tags":["osint","email"]},{"id":"recon-ip-asn","n":"ASN 与旁站测绘","cat":"信息收集","phase":"recon","d":"按 ASN 拉取组织全部 IP 段，扩展内网边界与旁站。","cmds":["amass intel -asn <ASN>","whois -h whois.radb.net -- '-i origin AS<ASN>'"],"tools":["amass","whois"],"tags":["recon","asn"]},{"id":"recon-google-dork","n":"搜索引擎语法测绘","cat":"信息收集","phase":"recon","d":"用 dork 定位后台、上传点、错误页与敏感文档。","cmds":["site:<domain> inurl:admin","site:<domain> ext:pdf OR ext:xls"],"tools":["dork"],"tags":["osint","dork"]},{"id":"recon-shodan","n":"空间测绘引擎检索","cat":"信息收集","phase":"recon","d":"用 FOFA/Quake/Shodan 语法定位暴露服务与默认页面。","cmds":["fofa 'domain=<domain> && port=8080'"],"tools":["fofa","quake","shodan"],"tags":["recon","mapping"]},{"id":"recon-robots-sitemap","n":"robots/sitemap 线索","cat":"信息收集","phase":"recon","d":"从 robots、sitemap、well-known 提取隐藏路径与接口。","cmds":["curl -s https://<host>/robots.txt","curl -s https://<host>/.well-known/security.txt"],"tools":["curl"],"tags":["recon"]},{"id":"recon-spa-route","n":"SPA 路由与懒加载分包","cat":"信息收集","phase":"recon","d":"解析前端路由表与懒加载 chunk，还原业务功能清单。","cmds":["katana -u <url> -headless -jc -d 4"],"tools":["katana","playwright"],"tags":["recon","spa"]},{"id":"recon-api-swagger","n":"API 文档与网关探测","cat":"信息收集","phase":"recon","d":"找 swagger/openapi/actuator 等暴露面并导出接口清单。","cmds":["curl -s https://<host>/v3/api-docs","curl -s https://<host>/actuator/mappings"],"tools":["curl","nuclei"],"tags":["api","recon"]},{"id":"recon-graphql-intro","n":"GraphQL 端点发现","cat":"信息收集","phase":"recon","d":"探测 /graphql 并尝试 introspection 获取 schema。","cmds":["curl -s -X POST https://<host>/graphql -d '{__schema{types{name}}}'"],"tools":["curl","graphql-voyager"],"tags":["api","graphql"]},{"id":"recon-websocket","n":"WebSocket 端点识别","cat":"信息收集","phase":"recon","d":"从 JS 与握手响应识别 ws 端点及鉴权方式。","cmds":["grep -oE 'wss?://[^ ]+' app.js | sort -u"],"tools":["websocat"],"tags":["websocket"]},{"id":"recon-ssh-banner","n":"服务横幅与版本画像","cat":"信息收集","phase":"recon","d":"采集 banner 判断精确版本，映射到已知 CVE 知识库。","cmds":["nc -nv <ip> 22","nmap -Pn -sV --version-all -p<port> <ip>"],"tools":["nc","nmap"],"tags":["fingerprint"]},{"id":"recon-mobile-api","n":"移动端接口还原","cat":"信息收集","phase":"recon","d":"从 APK/IPA 提取 baseURL、签名算法与隐藏接口。","cmds":["jadx -d out app.apk","strings Payload/App.app/App | grep -i api"],"tools":["jadx","frida"],"tags":["mobile"]},{"id":"recon-whois-history","n":"域名资产变更追溯","cat":"信息收集","phase":"recon","d":"用历史 whois/DNS 变更发现迁移遗留的老系统。","cmds":["whois <domain> | grep -i 'Creation Date'","curl -s 'https://api.hackertarget.com/dnslookup/?q=<domain>'"],"tools":["whois"],"tags":["osint"]},{"id":"recon-param-mining","n":"隐藏参数挖掘","cat":"信息收集","phase":"recon","d":"用 arjun/x8 找未在文档中出现的可注入参数。","cmds":["arjun -u https://<host>/api/x --stable"],"tools":["arjun"],"tags":["param"]},{"id":"recon-backup-leak","n":"备份与源码泄露","cat":"信息收集","phase":"recon","d":"按常见后缀与 VCS 目录探测 .git/.svn/.bak/.zip 泄露。","cmds":["ffuf -u https://<host>/FUZZ -w backup.txt -mc 200"],"tools":["ffuf","githacker"],"tags":["leak"]},{"id":"recon-intranet-via-dns","n":"内部域名泄露面","cat":"信息收集","phase":"recon","d":"从邮件头、加载的脚本与错误信息收集内网域名。","cmds":["curl -sI https://<host>/ | grep -i location","nslookup <internal-domain> <dns>"],"tools":["nslookup"],"tags":["dns"]},{"id":"recon-static-assets","n":"静态资源与存储汇聚","cat":"信息收集","phase":"recon","d":"归集 OSS/CDN 静态资源，检查目录遍历与陈旧备份。","cmds":["ffuf -u https://<bucket>/FUZZ -w files.txt"],"tools":["ffuf"],"tags":["cloud"]},{"id":"recon-email-headers","n":"邮件头与网关识别","cat":"信息收集","phase":"recon","d":"从发信 SPF/DKIM/DMARC 与邮件头识别邮件网关产品。","cmds":["dig +short TXT _dmarc.<domain>"],"tools":["dig"],"tags":["email"]},{"id":"recon-exposed-panels","n":"暴露面板采集","cat":"信息收集","phase":"recon","d":"定位 Grafana/Zabbix/ELK/SonarQube 等运维面板并核对版本。","cmds":["nuclei -l alive.txt -tags panel,exposure -severity info,low,medium"],"tools":["nuclei"],"tags":["panel"]},{"id":"recon-wordlist-build","n":"专用字典构造","cat":"信息收集","phase":"recon","d":"用目标品牌词、内网命名与历史路径构造定制字典。","cmds":["cewl https://<host> -m 5 -w custom.txt"],"tools":["cewl"],"tags":["dict"]},{"id":"recon-structure-map","n":"资产结构图绘制","cat":"信息收集","phase":"recon","d":"把域名、IP、端口、站点、接口整理成可检索的资产树。","cmds":["httpx -l alive.txt -json -o assets.json"],"tools":["httpx","jq"],"tags":["recon","mapping"]},{"id":"fp-tech-stack","n":"技术栈精确指纹","cat":"指纹测绘","phase":"fingerprint","d":"按 header、icon hash、报错特征精确到框架与版本。","cmds":["whatweb -a 3 https://<host>","curl -sI https://<host> | grep -i server"],"tools":["whatweb","httpx"],"tags":["fingerprint"]},{"id":"fp-favicon-hash","n":"Favicon 哈希聚类","cat":"指纹测绘","phase":"fingerprint","d":"用 mmh3 哈希把同源系统聚类，快速找同类资产。","cmds":["python3 -c \"import mmh3,requests;print(mmh3.hash(requests.get('https://<host>/favicon.ico').content))\""],"tools":["python"],"tags":["fingerprint"]},{"id":"fp-error-page","n":"错误页与调试信息","cat":"指纹测绘","phase":"fingerprint","d":"通过畸形请求触发堆栈或版本泄露，确定组件与路径。","cmds":["curl -s 'https://<host>/%27' | head -50","curl -s 'https://<host>/..%2f..%2f'"],"tools":["curl"],"tags":["fingerprint","info"]},{"id":"fp-cms-detect","n":"CMS 与插件识别","cat":"指纹测绘","phase":"fingerprint","d":"识别 WordPress/Drupal/Joomla 及插件版本，映射到已知漏洞。","cmds":["wpscan --url https://<host> --enumerate vp,vt","droopescan scan drupal -u https://<host>"],"tools":["wpscan","droopescan"],"tags":["cms"]},{"id":"fp-java-middleware","n":"Java 中间件识别","cat":"指纹测绘","phase":"fingerprint","d":"识别 Tomcat/WebLogic/WebSphere/JBoss 及管理控制台版本。","cmds":["curl -s https://<host>/manager/html","nmap -Pn -p 7001,7002,9043,9060 --script http-title <ip>"],"tools":["nmap"],"tags":["java","middleware"]},{"id":"fp-oa-detect","n":"国产 OA/ERP 识别","cat":"指纹测绘","phase":"fingerprint","d":"识别致远、泛微、用友、通达等系统版本与已知 RCE 入口。","cmds":["curl -s https://<host>/seeyon/ | head","curl -s https://<host>/wui/index.html"],"tools":["curl"],"tags":["oa"]},{"id":"fp-edge-device","n":"边界设备识别","cat":"指纹测绘","phase":"fingerprint","d":"识别 VPN、防火墙、负载均衡型号固件，对应公开 CVE。","cmds":["curl -sk https://<host>/remote/login | head","nmap -Pn --script ssl-cert <ip>"],"tools":["nmap","curl"],"tags":["edge"]},{"id":"fp-cicd-platform","n":"CI/CD 平台识别","cat":"指纹测绘","phase":"fingerprint","d":"识别 Jenkins/GitLab/TeamCity/ArgoCD 版本与匿名访问面。","cmds":["curl -s 'https://<host>/api/json?pretty=1'","curl -s https://<host>/version"],"tools":["curl"],"tags":["cicd"]},{"id":"fp-data-service","n":"数据服务协议识别","cat":"指纹测绘","phase":"fingerprint","d":"对 MySQL/PostgreSQL/Redis/MongoDB/ES 做协议级指纹与认证方式判断。","cmds":["nmap -Pn -sV -p 3306,5432,6379,27017,9200 <ip>"],"tools":["nmap","nerva"],"tags":["database"]},{"id":"fp-actuator","n":"Spring Actuator 探测","cat":"指纹测绘","phase":"fingerprint","d":"检查 actuator 端点族是否暴露 env、heapdump、mappings。","cmds":["curl -s -o /dev/null -w '%{http_code} env\\n' https://<host>/actuator/env"],"tools":["curl"],"tags":["spring"]},{"id":"fp-version-map-cve","n":"版本到 CVE 映射","cat":"指纹测绘","phase":"fingerprint","d":"把服务版本对齐本地 CVE 知识库，按可利用性排序候选。","cmds":["nuclei -u https://<host> -tags cve -severity critical,high"],"tools":["nuclei"],"tags":["cve"]},{"id":"fp-tls-audit","n":"TLS 配置审计","cat":"指纹测绘","phase":"fingerprint","d":"检查弱协议、弱套件、证书主体与 SAN，找额外域名。","cmds":["testssl.sh --quiet https://<host>","sslyze --regular <host>:443"],"tools":["testssl.sh","sslyze"],"tags":["tls"]},{"id":"fp-jarm-fingerprint","n":"JARM/JA3 指纹","cat":"指纹测绘","phase":"fingerprint","d":"用 TLS 指纹聚类同类服务，识别隐藏的反代与蜜罐。","cmds":["httpx -l hosts.txt -jarm -json -o jarm.json"],"tools":["httpx","tlsx"],"tags":["tls"]},{"id":"fp-honeypot-check","n":"蜜罐与仿真识别","cat":"指纹测绘","phase":"fingerprint","d":"通过行为不一致、版本矛盾判断目标是否为仿真环境。","cmds":["nmap -Pn -sV --version-intensity 9 -p<port> <ip>"],"tools":["nmap"],"tags":["fingerprint"]},{"id":"fp-portal-login","n":"登录入口归类","cat":"指纹测绘","phase":"fingerprint","d":"汇总所有登录页并按框架、验证码、SSO 类型分类。","cmds":["ffuf -u https://<host>/FUZZ -w login_paths.txt -mc 200"],"tools":["ffuf"],"tags":["auth"]},{"id":"fp-cdn-origin-diff","n":"CDN 与源站差异比对","cat":"指纹测绘","phase":"fingerprint","d":"对比 CDN 与直连源站的响应差异，找未受保护的源。","cmds":["curl -s -H 'Host: <domain>' https://<origin-ip>/ | head"],"tools":["curl"],"tags":["cdn"]},{"id":"fp-waf-vendor","n":"WAF 指纹与规则画像","cat":"指纹测绘","phase":"fingerprint","d":"按拦截页特征判断 WAF 厂商，为绕过策略提供依据。","cmds":["curl -s 'https://<host>/?id=1%27' -o /dev/null -w '%{http_code}'"],"tools":["wafw00f"],"tags":["waf"]},{"id":"fp-spring-boot-detect","n":"Spring Boot 版本画像","cat":"指纹测绘","phase":"fingerprint","d":"从 whitelabel 错误页与 actuator 推断 Spring Boot 大版本。","cmds":["curl -s https://<host>/error | head -20"],"tools":["curl"],"tags":["spring"]},{"id":"fp-nginx-module","n":"Nginx/Apache 模块识别","cat":"指纹测绘","phase":"fingerprint","d":"从报错与响应头判断解析模块与路径穿越可能性。","cmds":["curl -s 'https://<host>/..%c0%af' -o /dev/null -w '%{http_code}'"],"tools":["curl"],"tags":["web-server"]},{"id":"fp-node-runtime","n":"Node/Go/Python 运行时识别","cat":"指纹测绘","phase":"fingerprint","d":"从 X-Powered-By、报错栈与静态目录特征判断运行时。","cmds":["curl -sI https://<host> | grep -iE 'x-powered-by|server'"],"tools":["curl"],"tags":["runtime"]},{"id":"fp-cloud-provider","n":"云厂商归属识别","cat":"指纹测绘","phase":"fingerprint","d":"按 ASN、响应头与元数据特征判断目标所属云平台。","cmds":["whois <ip> | grep -i orgname","curl -sI https://<host> | grep -i x-amz"],"tools":["whois","curl"],"tags":["cloud"]},{"id":"fp-asset-correlate","n":"资产关联归并","cat":"指纹测绘","phase":"fingerprint","d":"按企业主体把域名、IP、证书、备案归并成资产簇。","cmds":["nuclei -l alive.txt -tags favicon -json -o fav.json"],"tools":["nuclei"],"tags":["recon"]}]